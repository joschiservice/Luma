{
  "name": "luma",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "node tooling/dev/cli.mjs dev",
    "build": "turbo run build build:storybook",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0 && pnpm lint:ui",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node tooling/dev/test.mjs test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node tooling/dev/test.mjs check",
    "verify:feature": "node tooling/dev/verify-feature.mjs",
    "storybook": "pnpm --filter @luma/ui storybook",
    "test:ui": "node tooling/dev/test.mjs ui",
    "build:storybook": "turbo run build:storybook",
    "screenshots:marketing": "pnpm --filter @luma/ui screenshots:marketing",
    "test:architecture": "node --test tooling/architecture/*.test.mjs",
    "test:style": "node --test tooling/style/*.test.mjs",
    "test:e2e": "node tooling/dev/test.mjs e2e",
    "test:browser": "node tooling/dev/test.mjs browser",
    "setup": "node tooling/dev/cli.mjs setup",
    "dev:manual": "turbo run dev",
    "dev:workflows": "node tooling/dev/cli.mjs workflows",
    "dev:doctor": "node tooling/dev/cli.mjs doctor",
    "dev:down": "node tooling/dev/cli.mjs down",
    "db:seed": "node tooling/dev/cli.mjs seed",
    "db:studio": "node tooling/dev/studio.mjs",
    "db:reset": "node tooling/dev/cli.mjs reset",
    "test:local": "node tooling/dev/test.mjs local",
    "test:affected": "node tooling/dev/test.mjs affected",
    "test:full": "node tooling/dev/test.mjs full",
    "test:tooling": "node --test tooling/dev/*.test.mjs",
    "pilot": "node tooling/pilot/cli.mjs serve",
    "pilot:seed": "node tooling/pilot/cli.mjs seed",
    "pilot:reset": "node tooling/pilot/cli.mjs reset",
    "pilot:worker": "node tooling/pilot/cli.mjs worker",
    "simulator": "node tooling/simulator/cli.mjs",
    "simulator:service": "pnpm exec turbo run build --filter=@luma/simulator... --filter=@luma/simulator-web && node tooling/simulator/service.mjs",
    "test:simulator": "node tooling/dev/test.mjs simulator-tooling",
    "dev:observe": "node tooling/dev/cli.mjs observe",
    "observe:verify": "node tooling/observability/verify.mjs",
    "observe:queries": "node tooling/observability/queries.mjs",
    "evaluate:playbook": "pnpm exec turbo run build --filter=@luma/resolution... --filter=@luma/simulator... && node tooling/evaluation/cli.mjs",
    "evaluate:red-team": "pnpm exec turbo run build --filter=@luma/resolution... --filter=@luma/simulator... && node tooling/evaluation/red-team-cli.mjs",
    "propose:red-team": "pnpm exec turbo run build --filter=@luma/config --filter=@luma/resolution... --filter=@luma/simulator... && node tooling/evaluation/red-team-propose-cli.mjs",
    "test:evaluation": "pnpm exec turbo run build --filter=@luma/config --filter=@luma/resolution... --filter=@luma/simulator... && node --test tooling/evaluation/*.test.mjs",
    "shopify:cost-check": "pnpm exec turbo run build --filter=@luma/tooling^... && node tooling/shopify/cost-check.mjs",
    "capture:incident": "pnpm exec turbo run build --filter=@luma/resolution... && node tooling/evaluation/capture-cli.mjs",
    "apps:sync": "node tooling/apps/generate.mjs && eslint --fix packages/app-catalog/src/generated.ts && prettier --write packages/app-catalog/src/generated.ts",
    "simulator:replenishment": "pnpm test:e2e replenishment.e2e.mjs",
    "setup:code": "node tooling/code-runtime/setup.mjs",
    "evaluate:code": "pnpm --filter @luma/workflows build && node tooling/evaluation/code-cli.mjs",
    "evaluate:authoring": "pnpm exec turbo run build --filter=@luma/resolution... --filter=@luma/config && node --env-file-if-exists=apps/api/.env tooling/evaluation/authoring-cli.mjs",
    "setup:benchmarks": "node tooling/benchmarks/setup.mjs",
    "benchmark": "node tooling/benchmarks/run.mjs",
    "test:browser:report": "pnpm --filter @luma/api exec playwright show-report ../../.luma/playwright/report",
    "knip": "knip",
    "knip:check": "knip --include files,dependencies,unlisted,unresolved --no-config-hints && knip --exports --include-entry-exports --no-config-hints",
    "typecheck:tooling": "turbo run typecheck --filter=@luma/tooling",
    "lint:ui": "node tooling/style/check-ui.mjs",
    "dev:staff": "node tooling/dev/cli.mjs staff",
    "test:region-eu": "LUMA_REGION=EU LUMA_ENABLED_REGIONS=EU node tooling/dev/test.mjs test --filter=@luma/application-runtime -- regions.integration.test.ts",
    "audit:dependencies": "node tooling/dev/dependency-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testcontainers/postgresql": "12.2.1",
    "testcontainers": "12.2.1",
    "@types/node": "catalog:",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "^16.5.0",
    "knip": "6.41.0",
    "pg": "catalog:pg-8-23-0",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "turbo": "2.11.8",
    "typescript": "catalog:typescript-compatible-5-9-3",
    "typescript-eslint": "^8.71.2",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
