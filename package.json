{
  "name": "luma",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "node tooling/dev/cli.mjs dev",
    "build": "turbo run build build:storybook",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node tooling/dev/test.mjs test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:feature": "node tooling/dev/verify-feature.mjs",
    "storybook": "pnpm --filter @luma/ui storybook",
    "test:ui": "pnpm --filter @luma/ui test",
    "build:storybook": "turbo run build:storybook",
    "test:architecture": "node --test tooling/architecture/*.test.mjs",
    "test:style": "node --test tooling/style/*.test.mjs",
    "test:e2e": "node tooling/dev/test.mjs e2e",
    "test:browser": "node tooling/dev/test.mjs browser",
    "setup": "node tooling/dev/cli.mjs setup",
    "dev:manual": "turbo run dev",
    "dev:workflows": "node tooling/dev/cli.mjs workflows",
    "dev:doctor": "node tooling/dev/cli.mjs doctor",
    "dev:down": "node tooling/dev/cli.mjs down",
    "db:seed": "node tooling/dev/cli.mjs seed",
    "db:studio": "node tooling/dev/studio.mjs",
    "db:reset": "node tooling/dev/cli.mjs reset",
    "test:local": "pnpm test:tooling && pnpm test:architecture && pnpm test:style && turbo run test",
    "test:full": "node tooling/dev/test.mjs full",
    "test:tooling": "node --test tooling/dev/*.test.mjs",
    "pilot": "node tooling/pilot/cli.mjs serve",
    "pilot:seed": "node tooling/pilot/cli.mjs seed",
    "pilot:reset": "node tooling/pilot/cli.mjs reset",
    "pilot:worker": "node tooling/pilot/cli.mjs worker",
    "simulator": "node tooling/simulator/cli.mjs",
    "simulator:service": "pnpm exec turbo run build --filter=@luma/simulator... && node apps/simulator/dist/server.js",
    "test:simulator": "pnpm exec turbo run build --filter=@luma/api... --filter=@luma/simulator... && pnpm exec turbo run test --filter=@luma/simulator... && node --test tooling/simulator/*.test.mjs",
    "dev:observe": "node tooling/dev/cli.mjs observe",
    "observe:verify": "node tooling/observability/verify.mjs",
    "observe:queries": "node tooling/observability/queries.mjs",
    "evaluate:playbook": "pnpm exec turbo run build --filter=@luma/resolution... --filter=@luma/simulator... && node tooling/evaluation/cli.mjs",
    "test:evaluation": "pnpm exec turbo run build --filter=@luma/resolution... --filter=@luma/simulator... && node --test tooling/evaluation/*.test.mjs",
    "capture:incident": "pnpm exec turbo run build --filter=@luma/resolution... && node tooling/evaluation/capture-cli.mjs",
    "apps:sync": "node tooling/apps/generate.mjs && prettier --write packages/app-catalog/src/generated.ts",
    "simulator:replenishment": "pnpm test:e2e replenishment.e2e.mjs",
    "setup:code": "node tooling/code-runtime/setup.mjs",
    "evaluate:code": "pnpm --filter @luma/workflows build && node tooling/evaluation/code-cli.mjs",
    "evaluate:authoring": "pnpm exec turbo run build --filter=@luma/resolution... --filter=@luma/config && node tooling/evaluation/authoring-cli.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "^16.5.0",
    "pg": "8.23.0",
    "prettier": "^3.6.2",
    "turbo": "2.10.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "4.1.11",
    "@luma/platform": "workspace:*",
    "@luma/identity": "workspace:*",
    "@luma/audit": "workspace:*",
    "@luma/orders": "workspace:*",
    "@luma/inventory": "workspace:*",
    "@luma/connections": "workspace:*",
    "@luma/policies": "workspace:*",
    "@luma/execution": "workspace:*",
    "@luma/exceptions": "workspace:*",
    "@luma/read-models": "workspace:*",
    "@luma/resolution": "workspace:*",
    "@luma/application-runtime": "workspace:*",
    "@luma/commerce-ingestion": "workspace:*",
    "@luma/workflow-temporal": "workspace:*",
    "@luma/app-host": "workspace:*",
    "@luma/app-catalog": "workspace:*",
    "@luma/app-jtl": "workspace:*",
    "@luma/app-shopify": "workspace:*",
    "@luma/workflows": "workspace:*",
    "@luma/procurement": "workspace:*"
  }
}
