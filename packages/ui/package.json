{
  "name": "@luma/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./src/button.tsx"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --output-dir storybook-static"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.6.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
