{
  "name": "@luma/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/primitives/*": "./src/components/primitives/*.tsx",
    "./components/issues/case-fixtures": "./src/components/issues/case-fixtures.ts",
    "./components/issues/resolution-fixtures": "./src/components/issues/resolution-fixtures.ts",
    "./components/issues/case-presentation": "./src/components/issues/case-presentation.ts",
    "./components/issues/*": "./src/components/issues/*.tsx",
    "./components/workspace/*": "./src/components/workspace/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/globals.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --output-dir storybook-static",
    "screenshots:marketing": "node scripts/marketing-screenshots.mjs"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@luma/api-contract": "workspace:*",
    "@luma/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "4.3.3",
    "ts-pattern": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@luma/i18n": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "catalog:",
    "react-resizable-panels": "4.14.7"
  }
