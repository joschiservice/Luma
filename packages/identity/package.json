{
  "name": "@luma/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "luma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composition": {
      "luma-source": "./src/composition.ts",
      "types": "./dist/composition.d.ts",
      "default": "./dist/composition.js"
    },
    "./http": {
      "luma-source": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@luma/api-contract": "workspace:*",
    "@ts-rest/fastify": "3.52.1",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "vitest": "4.1.11"
  }
}
