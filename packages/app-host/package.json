{
  "name": "@luma/app-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "luma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "luma-source": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./web": {
      "types": "./src/web.ts",
      "default": "./src/web.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache --passWithNoTests"
  },
  "dependencies": {
    "@luma/api-contract": "workspace:*",
    "@luma/connections": "workspace:*",
    "@luma/identity": "workspace:*",
    "@luma/platform": "workspace:*",
    "@luma/workflows": "workspace:*",
    "@orpc/server": "catalog:",
    "fastify": "catalog:"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
