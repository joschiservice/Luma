{
  "name": "@luma/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "luma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composition": {
      "luma-source": "./src/composition.ts",
      "types": "./dist/composition.d.ts",
      "default": "./dist/composition.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache --passWithNoTests"
  },
  "dependencies": {
    "@langfuse/otel": "6.0.2",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/instrumentation-runtime-node": "0.36.1",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@pyroscope/nodejs": "0.7.0",
    "@sentry/node": "10.76.2",
    "@sentry/opentelemetry": "10.76.2",
    "@valkey/valkey-glide": "2.5.3",
    "pg": "catalog:",
    "posthog-node": "5.57.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  }
}
