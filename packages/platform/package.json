{
  "name": "@luma/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "luma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composition": {
      "luma-source": "./src/composition.ts",
      "types": "./dist/composition.d.ts",
      "default": "./dist/composition.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@langfuse/otel": "5.13.1",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-runtime-node": "0.36.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@pyroscope/nodejs": "0.6.5",
    "@sentry/node": "10.75.0",
    "@sentry/opentelemetry": "10.75.0",
    "@valkey/valkey-glide": "2.5.3",
    "pg": "catalog:pg-8-20-0",
    "posthog-node": "5.55.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  }
}
