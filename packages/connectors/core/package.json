{
  "name": "@luma/connector-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.ts",
      "import": "./dist/dispatch.js"
    }
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
