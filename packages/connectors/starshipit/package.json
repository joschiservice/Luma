{
  "name": "@luma/connector-starshipit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "dependencies": {
    "zod": "catalog:",
    "@luma/connector-core": "workspace:*"
  }
}
