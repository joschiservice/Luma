{
  "name": "@luma/connections",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "luma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composition": {
      "luma-source": "./src/composition.ts",
      "types": "./dist/composition.d.ts",
      "default": "./dist/composition.js"
    },
    "./adapters": {
      "luma-source": "./src/adapters.ts",
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./http": {
      "luma-source": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@luma/api-contract": "workspace:*",
    "@luma/connector-core": "workspace:*",
    "@luma/connector-jtl": "workspace:*",
    "@luma/connector-shopify": "workspace:*",
    "@luma/identity": "workspace:*",
    "@luma/platform": "workspace:*",
    "@ts-rest/fastify": "3.52.1",
    "fastify": "5.12.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "vitest": "4.1.11"
  }
}
