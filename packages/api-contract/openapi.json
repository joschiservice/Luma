    "/v1/connector-providers": {
      "get": {
        "description": "Browse provider names and categories. Filter by storefront or ERP.",
        "summary": "List connector providers",
        "tags": ["connectorProviders"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["storefront", "erp"]
            }
          }
        ],
        "operationId": "connectorProviders.list",
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]*$"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "category": {
                            "type": "string",
                            "enum": ["storefront", "erp"]
                          }
                        },
                        "required": ["id", "name", "category"]
                      }
                    }
                  },
                  "required": ["items"]
