{
  "name": "@luma/application-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "luma-source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./worker": {
      "luma-source": "./src/composition/workflow-runtime.ts",
      "types": "./dist/composition/workflow-runtime.d.ts",
      "default": "./dist/composition/workflow-runtime.js"
    },
    "./sync": {
      "luma-source": "./src/composition/commerce-sync.ts",
      "types": "./dist/composition/commerce-sync.d.ts",
      "default": "./dist/composition/commerce-sync.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "node scripts/migrate.mjs",
    "db:provision-region": "node scripts/provision-region.mjs"
  },
  "dependencies": {
    "@luma/api-contract": "workspace:*",
    "@luma/app-catalog": "workspace:*",
    "@luma/app-host": "workspace:*",
    "@luma/assistant": "workspace:*",
    "@luma/audit": "workspace:*",
    "@luma/commerce-ingestion": "workspace:*",
    "@luma/commerce-sync": "workspace:*",
    "@luma/config": "workspace:*",
    "@luma/connections": "workspace:*",
    "@luma/customers": "workspace:*",
    "@luma/exceptions": "workspace:*",
    "@luma/execution": "workspace:*",
    "@luma/identity": "workspace:*",
    "@luma/inventory": "workspace:*",
    "@luma/messaging": "workspace:*",
    "@luma/orders": "workspace:*",
    "@luma/platform": "workspace:*",
    "@luma/policies": "workspace:*",
    "@luma/procurement": "workspace:*",
    "@luma/read-models": "workspace:*",
    "@luma/resolution": "workspace:*",
    "@luma/workflow-temporal": "workspace:*",
    "@luma/workflows": "workspace:*",
    "@orpc/server": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:pg-8-20-0",
    "zod": "catalog:",
    "@luma/sales": "workspace:*",
    "@luma/adaptive": "workspace:*"
  },
  "devDependencies": {
    "@luma/connector-shopify": "workspace:*",
    "testcontainers": "12.1.0",
    "@luma/typescript-config": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@temporalio/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "graphql": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:",
    "@luma/staff": "workspace:*",
    "@luma/simulator-core": "workspace:*",
    "@luma/simulator-shopify": "workspace:*",
    "@luma/app-cin7": "workspace:*",
    "@luma/app-jtl": "workspace:*",
    "@luma/app-shopify": "workspace:*"
  }
}
