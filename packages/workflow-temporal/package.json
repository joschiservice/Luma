  },
  "dependencies": {
    "@luma/identity": "workspace:*",
    "@luma/platform": "workspace:*",
    "@luma/resolution": "workspace:*",
    "@luma/workflows": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/interceptors-opentelemetry-v2": "1.24.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.24.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@temporalio/testing": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
