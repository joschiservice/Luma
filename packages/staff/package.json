{
  "name": "@luma/staff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "luma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composition": {
      "luma-source": "./src/composition.ts",
      "types": "./dist/composition.d.ts",
      "default": "./dist/composition.js"
    },
    "./http": {
      "luma-source": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@luma/api-contract": "workspace:*",
    "@luma/identity": "workspace:*",
    "@luma/identity-provider": "workspace:*",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.2",
    "fastify": "catalog:",
    "pg": "catalog:pg-8-20-0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  }
}
