{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Exports read by tools that knip does not follow.
  "ignoreIssues": {
    // tooling/dev/studio.mjs passes this file to drizzle-kit studio.
    "apps/api/drizzle.studio.config.ts": ["exports"],
    // Better Auth reads the tables from this module namespace by model name.
    "packages/identity/src/infrastructure/schema.ts": ["exports"],
    // Hand-written declarations for vite.mjs.
    "packages/i18n/vite.d.mts": ["exports"],
    // Consumers import the built package, since its JSX needs the package's own compiler settings.
    "packages/email/src/index.ts": ["exports"],
  },
  "ignoreBinaries": ["docker", "mise", "hyperfine"],
  "workspaces": {
    ".": { "project": ["*.mjs"] },
    "tooling": {
      "entry": [
        "**/*.test.mjs",
        "orders/rebuild-list.mjs",
        "benchmarks/commerce.mjs",
      ],
      "project": ["**/*.mjs"],
      // The app generator writes this import into another workspace. Observability loads the
      // OpenTelemetry hook from the API's dependencies, which the instrumented processes use.
      "ignoreDependencies": [
        "@luma/app-host",
        "@opentelemetry/instrumentation",
      ],
    },
    "apps/api": {
      "entry": [
        "e2e/*.e2e.mjs",
        "e2e/*.browser.mjs",
        "e2e/*-server.mjs",
        "e2e/execution-worker.mjs",
        "drizzle.studio.config.ts",
        "scripts/update-shopify-schema.mjs",
      ],
      "project": [
        "src/**/*.ts",
        "e2e/**/*.mjs",
        "scripts/update-shopify-schema.mjs",
        "*.ts",
      ],
      // Journey servers start the web and staff apps with each app's own Vite.
      "ignoreDependencies": ["vite"],
    },
    // The web tsconfig compiles every app's web sources, so the web typecheck and build need the
    // apps and their connectors built first; knip does not follow tsconfig includes.
    "apps/web": {
      "ignoreDependencies": [
        "@luma/app-cin7",
        "@luma/app-gmail",
        "@luma/app-jtl",
        "@luma/app-shopify",
        "@luma/app-starshipit",
      ],
    },
    // cdk.json runs the CDK app with tsx; the aws-cdk CLI is used only as a binary.
    "infra": { "entry": ["src/app.ts"], "ignoreDependencies": ["tsx"] },
    "apps/simulator": { "entry": ["src/server.ts"] },
    "apps/simulator-web": { "entry": ["src/main.tsx"] },
    "apps/staff": { "entry": ["src/main.tsx"] },
    "apps/staff-api": { "entry": ["src/index.ts", "scripts/*.mjs"] },
    "packages/api-contract": { "entry": ["src/generate-openapi.ts"] },
    "packages/application-runtime": {
      "entry": ["scripts/*.mjs"],
      // CLI integration tests load tsx through child_process execArgv --import.
      "ignoreDependencies": ["tsx"],
    },
    // The inlang project settings load the ICU storage plugin from node_modules by path.
    // The React Email preview server renders every file in previews and loads its UI package itself.
    "packages/email": {
      "entry": ["previews/**/*.tsx"],
      "ignoreDependencies": ["@react-email/ui"],
    },
    "packages/i18n": {
      "entry": ["scripts/compile.mjs", "vite.mjs"],
      "ignoreDependencies": ["@inlang/plugin-icu1"],
    },
    "packages/ui": {
      "entry": [".storybook/*.{ts,tsx}", "src/**/*.stories.tsx"],
    },
  },
}
