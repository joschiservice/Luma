{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "rules": { "types": "off", "nsTypes": "off" },
  "ignoreBinaries": ["docker", "mise", "hyperfine"],
  "workspaces": {
    ".": { "project": ["*.mjs"] },
    "tooling": {
      "entry": [
        "**/*.test.mjs",
        "orders/rebuild-list.mjs",
        "benchmarks/commerce.mjs",
      ],
      "project": ["**/*.mjs"],
      // The app generator writes this import into another workspace. Observability loads the
      // OpenTelemetry hook from the API's dependencies, which the instrumented processes use.
      "ignoreDependencies": [
        "@luma/app-host",
        "@opentelemetry/instrumentation",
      ],
    },
    "apps/api": {
      "entry": [
        "e2e/*.e2e.mjs",
        "e2e/*.browser.mjs",
        "e2e/*-server.mjs",
        "e2e/execution-worker.mjs",
        "drizzle.studio.config.ts",
        "scripts/update-shopify-schema.mjs",
      ],
      "project": [
        "src/**/*.ts",
        "e2e/**/*.mjs",
        "scripts/update-shopify-schema.mjs",
        "*.ts",
      ],
      // Journey servers start the web and staff apps with each app's own Vite.
      "ignoreDependencies": ["vite"],
    },
    "apps/simulator": { "entry": ["src/server.ts"] },
    "apps/simulator-web": { "entry": ["src/main.tsx"] },
    "apps/staff": { "entry": ["src/main.tsx"] },
    "apps/staff-api": { "entry": ["src/index.ts", "scripts/*.mjs"] },
    "packages/api-contract": {
      "entry": ["src/generate-openapi.ts", "src/staff.ts"],
    },
    // Public subpaths resolve to compiled output; retain their source entry points.
    "packages/connectors/*": { "entry": ["src/index.ts", "src/schemas.ts"] },
    "packages/application-runtime": {
      "entry": ["scripts/*.mjs"],
      // CLI integration tests load tsx through child_process execArgv --import.
      "ignoreDependencies": ["tsx"],
    },
    // The inlang project settings load the ICU storage plugin from node_modules by path.
    "packages/i18n": {
      "entry": ["scripts/compile.mjs", "vite.mjs"],
      "ignoreDependencies": ["@inlang/plugin-icu1"],
    },
    "packages/ui": {
      "entry": [".storybook/*.{ts,tsx}", "src/**/*.stories.tsx"],
    },
  },
}
