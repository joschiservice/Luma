{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "globalDependencies": [".env", "**/.env", "**/.env.*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["TEST_DATABASE_URL"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "MODEL_GATEWAY_ROUTES",
        "MODEL_GATEWAY_TIMEOUT_MS",
        "AI_GATEWAY_API_KEY",
        "MODEL_GATEWAY_BEDROCK_REGION",
        "MODEL_GATEWAY_BEDROCK_ACCESS_KEY_ID",
        "MODEL_GATEWAY_BEDROCK_SECRET_ACCESS_KEY",
        "MODEL_GATEWAY_BEDROCK_SESSION_TOKEN",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "IDENTITY_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_ORIGINS",
        "OBSERVABILITY_ENVIRONMENT",
        "OBSERVABILITY_RELEASE",
        "OBSERVABILITY_SAMPLE_RATE",
        "OBSERVABILITY_TENANT_HASH_KEY",
        "SENTRY_DSN",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "LANGFUSE_BASE_URL",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "WORKFLOW_DATABASE_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "TEMPORAL_DATA_REGION",
        "TEMPORAL_TLS",
        "TEMPORAL_API_KEY",
        "WEB_PORT",
        "API_PROXY_TARGET",
        "BETTER_AUTH_COOKIE_PREFIX",
        "CONNECTIONS_ACTIVE_KEY_ID",
        "CONNECTIONS_KEYS",
        "JTL_ALLOWED_ENDPOINTS",
        "COMMERCE_SYNC_CONCURRENCY",
        "COMMERCE_SYNC_WORKSPACE_CONCURRENCY",
        "COMMERCE_SYNC_CONNECTION_CONCURRENCY",
        "SHOPIFY_CLIENT_ID",
        "SHOPIFY_CLIENT_SECRET",
        "SHOPIFY_APP_ENVIRONMENT",
        "SHOPIFY_CALLBACK_URL",
        "SHOPIFY_WEB_ORIGIN",
        "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS",
        "LUMA_LOCAL_OTLP_ENDPOINT",
        "LUMA_LOCAL_PROFILES_ENDPOINT",
        "LUMA_CODE_RUNTIME_DIR",
        "LUMA_SIMULATOR_ORIGIN",
        "STAFF_DATABASE_URL",
        "STAFF_AUTH_SECRET",
        "STAFF_PUBLIC_ORIGIN",
        "STAFF_AUTH_MODE",
        "STAFF_API_HOST",
        "STAFF_API_PORT",
        "STAFF_API_PROXY_TARGET",
        "STAFF_WEB_PORT",
        "STAFF_COOKIE_PREFIX",
        "STAFF_GOOGLE_CLIENT_ID",
        "STAFF_GOOGLE_CLIENT_SECRET",
        "STAFF_GOOGLE_HOSTED_DOMAIN",
        "STAFF_TRUSTED_PROXY"
      ]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/apps/web/tsconfig.json",
        "$TURBO_ROOT$/packages/apps/*/src/**",
        "$TURBO_ROOT$/packages/apps/*/package.json"
      ],
      "outputs": ["storybook-static/**"]
    },
    "dev:worker": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "MODEL_GATEWAY_ROUTES",
        "MODEL_GATEWAY_TIMEOUT_MS",
        "AI_GATEWAY_API_KEY",
        "MODEL_GATEWAY_BEDROCK_REGION",
        "MODEL_GATEWAY_BEDROCK_ACCESS_KEY_ID",
        "MODEL_GATEWAY_BEDROCK_SECRET_ACCESS_KEY",
        "MODEL_GATEWAY_BEDROCK_SESSION_TOKEN",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "IDENTITY_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_ORIGINS",
        "OBSERVABILITY_ENVIRONMENT",
        "OBSERVABILITY_RELEASE",
        "OBSERVABILITY_SAMPLE_RATE",
        "OBSERVABILITY_TENANT_HASH_KEY",
        "SENTRY_DSN",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "LANGFUSE_BASE_URL",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "WORKFLOW_DATABASE_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "TEMPORAL_DATA_REGION",
        "TEMPORAL_TLS",
        "TEMPORAL_API_KEY",
        "WEB_PORT",
        "API_PROXY_TARGET",
        "BETTER_AUTH_COOKIE_PREFIX",
        "CONNECTIONS_ACTIVE_KEY_ID",
        "CONNECTIONS_KEYS",
        "JTL_ALLOWED_ENDPOINTS",
        "SHOPIFY_CLIENT_ID",
        "SHOPIFY_CLIENT_SECRET",
        "SHOPIFY_APP_ENVIRONMENT",
        "SHOPIFY_CALLBACK_URL",
        "SHOPIFY_WEB_ORIGIN",
        "LUMA_LOCAL_OTLP_ENDPOINT",
        "LUMA_LOCAL_PROFILES_ENDPOINT",
        "LUMA_CODE_RUNTIME_DIR"
      ]
    },
    "@luma/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/apps/*/src/**",
        "$TURBO_ROOT$/packages/apps/*/package.json"
      ],
      "outputs": ["dist/**"]
    },
    "@luma/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/apps/*/src/**",
        "$TURBO_ROOT$/packages/apps/*/package.json"
      ],
      "outputs": []
    }
  }
}
