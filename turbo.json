{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "globalDependencies": [".env", "**/.env", "**/.env.*"],
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["LUMA_TEST_CAPABILITIES"],
      "passThroughEnv": ["TEST_DATABASE_URL", "SHOPIFY_ADMISSION_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "MODEL_GATEWAY_ROUTES",
        "MODEL_GATEWAY_TIMEOUT_MS",
        "MODEL_TENANT_DAILY_TOKENS",
        "AI_GATEWAY_API_KEY",
        "MODEL_GATEWAY_BEDROCK_REGION",
        "MODEL_GATEWAY_BEDROCK_ACCESS_KEY_ID",
        "MODEL_GATEWAY_BEDROCK_SECRET_ACCESS_KEY",
        "MODEL_GATEWAY_BEDROCK_SESSION_TOKEN",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "API_DATABASE_POOL_MAX",
        "NODE_ENV",
        "IDENTITY_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_ORIGINS",
        "OBSERVABILITY_ENVIRONMENT",
        "OBSERVABILITY_RELEASE",
        "OBSERVABILITY_SAMPLE_RATE",
        "OBSERVABILITY_TENANT_HASH_KEY",
        "SENTRY_DSN",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "LANGFUSE_BASE_URL",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "POSTHOG_SECRET_KEY",
        "FEATURE_FLAG_OVERRIDES",
        "FEATURE_FLAGS",
        "WORKFLOW_DATABASE_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "TEMPORAL_DATA_REGION",
        "TEMPORAL_TLS",
        "TEMPORAL_TLS_SERVER_CA",
        "TEMPORAL_API_KEY",
        "WEB_PORT",
        "API_PROXY_TARGET",
        "BETTER_AUTH_COOKIE_PREFIX",
        "CONNECTIONS_ACTIVE_KEY_ID",
        "CONNECTIONS_KEYS",
        "JTL_ALLOWED_ENDPOINTS",
        "COMMERCE_SYNC_CONCURRENCY",
        "COMMERCE_SYNC_WORKSPACE_CONCURRENCY",
        "COMMERCE_SYNC_CONNECTION_CONCURRENCY",
        "COMMERCE_SYNC_HEALTH_PORT",
        "MESSAGING_RETENTION_DAYS",
        "MESSAGING_POLL_SECONDS",
        "WORKSPACE_CLOSURE_RETENTION_DAYS",
        "AUDIT_RETENTION_DAYS",
        "SHOPIFY_CLIENT_ID",
        "SHOPIFY_CLIENT_SECRET",
        "SHOPIFY_APP_ENVIRONMENT",
        "SHOPIFY_CALLBACK_URL",
        "SHOPIFY_WEB_ORIGIN",
        "GMAIL_CLIENT_ID",
        "GMAIL_CLIENT_SECRET",
        "GMAIL_APP_ENVIRONMENT",
        "GMAIL_CALLBACK_URL",
        "GMAIL_WEB_ORIGIN",
        "GMAIL_PUBSUB_TOPIC",
        "GMAIL_PUSH_AUDIENCE",
        "GMAIL_PUSH_SERVICE_ACCOUNT",
        "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS",
        "LUMA_LOCAL_OTLP_ENDPOINT",
        "LUMA_LOCAL_PROFILES_ENDPOINT",
        "LUMA_CODE_RUNTIME_DIR",
        "LUMA_SIMULATOR_ORIGIN",
        "STAFF_DATABASE_URL",
        "STAFF_AUTH_SECRET",
        "STAFF_PUBLIC_ORIGIN",
        "STAFF_CUSTOMER_ORIGIN",
        "STAFF_AUTH_MODE",
        "STAFF_API_HOST",
        "STAFF_API_PORT",
        "STAFF_API_PROXY_TARGET",
        "STAFF_WEB_PORT",
        "STAFF_COOKIE_PREFIX",
        "STAFF_GOOGLE_CLIENT_ID",
        "STAFF_GOOGLE_CLIENT_SECRET",
        "STAFF_GOOGLE_HOSTED_DOMAIN",
        "STAFF_TRUSTED_PROXY",
        "SHOPIFY_ADMISSION_URL",
        "SHOPIFY_ADMISSION_CLUSTER",
        "LUMA_REGIONAL_SERVICE_ENDPOINTS",
        "LUMA_REGIONAL_ORIGINS",
        "LUMA_GLOBAL_ENTRY_URL",
        "AUTH_PASSKEY_RP_ID",
        "AUTH_RATE_LIMIT",
        "AUTH_RATE_LIMIT_URL",
        "AUTH_RATE_LIMIT_CLUSTER",
        "AUTH_CLIENT_IP_HEADER",
        "STAFF_REGIONAL_API_ORIGINS",
        "GMAIL_PUBSUB_STORAGE_REGIONS",
        "TEMPORAL_KMS_KEY_ARN",
        "TEMPORAL_KMS_DECRYPTION_KEY_ARNS",
        "TEMPORAL_KMS_REGION",
        "TEMPORAL_KMS_ACCESS_KEY_ID",
        "TEMPORAL_KMS_SECRET_ACCESS_KEY",
        "TEMPORAL_KMS_SESSION_TOKEN",
        "TEMPORAL_KMS_CACHE_TTL_MS",
        "TEMPORAL_KMS_CACHE_MAX_USES"
      ]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/apps/web/tsconfig.json",
        "$TURBO_ROOT$/packages/apps/*/src/**",
        "$TURBO_ROOT$/packages/apps/*/package.json"
      ],
      "outputs": ["storybook-static/**"]
    },
    "dev:worker": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "MODEL_GATEWAY_ROUTES",
        "MODEL_GATEWAY_TIMEOUT_MS",
        "MODEL_TENANT_DAILY_TOKENS",
        "AI_GATEWAY_API_KEY",
        "MODEL_GATEWAY_BEDROCK_REGION",
        "MODEL_GATEWAY_BEDROCK_ACCESS_KEY_ID",
        "MODEL_GATEWAY_BEDROCK_SECRET_ACCESS_KEY",
        "MODEL_GATEWAY_BEDROCK_SESSION_TOKEN",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "API_DATABASE_POOL_MAX",
        "NODE_ENV",
        "IDENTITY_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_ORIGINS",
        "OBSERVABILITY_ENVIRONMENT",
        "OBSERVABILITY_RELEASE",
        "OBSERVABILITY_SAMPLE_RATE",
        "OBSERVABILITY_TENANT_HASH_KEY",
        "SENTRY_DSN",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "LANGFUSE_BASE_URL",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "POSTHOG_SECRET_KEY",
        "FEATURE_FLAG_OVERRIDES",
        "FEATURE_FLAGS",
        "WORKFLOW_DATABASE_URL",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "TEMPORAL_DATA_REGION",
        "WORKFLOW_WORKER_HEALTH_PORT",
        "TEMPORAL_TLS",
        "TEMPORAL_TLS_SERVER_CA",
        "TEMPORAL_API_KEY",
        "WEB_PORT",
        "API_PROXY_TARGET",
        "BETTER_AUTH_COOKIE_PREFIX",
        "CONNECTIONS_ACTIVE_KEY_ID",
        "CONNECTIONS_KEYS",
        "JTL_ALLOWED_ENDPOINTS",
        "SHOPIFY_CLIENT_ID",
        "SHOPIFY_CLIENT_SECRET",
        "SHOPIFY_APP_ENVIRONMENT",
        "SHOPIFY_CALLBACK_URL",
        "SHOPIFY_WEB_ORIGIN",
        "GMAIL_CLIENT_ID",
        "GMAIL_CLIENT_SECRET",
        "GMAIL_APP_ENVIRONMENT",
        "GMAIL_CALLBACK_URL",
        "GMAIL_WEB_ORIGIN",
        "GMAIL_PUBSUB_TOPIC",
        "GMAIL_PUSH_AUDIENCE",
        "GMAIL_PUSH_SERVICE_ACCOUNT",
        "LUMA_LOCAL_OTLP_ENDPOINT",
        "LUMA_LOCAL_PROFILES_ENDPOINT",
        "LUMA_CODE_RUNTIME_DIR",
        "SHOPIFY_ADMISSION_URL",
        "SHOPIFY_ADMISSION_CLUSTER",
        "LUMA_REGIONAL_SERVICE_ENDPOINTS",
        "LUMA_REGIONAL_ORIGINS",
        "LUMA_GLOBAL_ENTRY_URL",
        "AUTH_PASSKEY_RP_ID",
        "AUTH_RATE_LIMIT",
        "AUTH_RATE_LIMIT_URL",
        "AUTH_RATE_LIMIT_CLUSTER",
        "AUTH_CLIENT_IP_HEADER",
        "STAFF_REGIONAL_API_ORIGINS",
        "GMAIL_PUBSUB_STORAGE_REGIONS",
        "TEMPORAL_KMS_KEY_ARN",
        "TEMPORAL_KMS_DECRYPTION_KEY_ARNS",
        "TEMPORAL_KMS_REGION",
        "TEMPORAL_KMS_ACCESS_KEY_ID",
        "TEMPORAL_KMS_SECRET_ACCESS_KEY",
        "TEMPORAL_KMS_SESSION_TOKEN",
        "TEMPORAL_KMS_CACHE_TTL_MS",
        "TEMPORAL_KMS_CACHE_MAX_USES"
      ]
    },
    "@luma/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/apps/*/src/**",
        "$TURBO_ROOT$/packages/apps/*/package.json"
      ],
      "outputs": ["dist/**"]
    },
    "@luma/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/apps/*/src/**",
        "$TURBO_ROOT$/packages/apps/*/package.json"
      ],
      "outputs": []
    }
  },
  "globalEnv": ["LUMA_REGION", "LUMA_ENABLED_REGIONS"]
}
