LUMA_REGION=AU
LUMA_ENABLED_REGIONS=AU
# Global console origin is STAFF_PUBLIC_ORIGIN; each API has its own host-only session.
# STAFF_REGIONAL_API_ORIGINS={"AU":"https://au.staff-api.<domain>"}
# FEATURE_FLAG_OVERRIDES=staff-regional-directory=true
# Staff API only. Do not use customer or migration credentials here.
STAFF_DATABASE_URL=postgresql://luma_staff:replace-me@127.0.0.1:5432/luma
STAFF_AUTH_SECRET=replace-with-at-least-32-random-characters
STAFF_PUBLIC_ORIGIN=https://staff.example.com
# The customer app's exact origin. Read-only support views open there; without it they can't start.
STAFF_CUSTOMER_ORIGIN=https://app.example.com
STAFF_AUTH_MODE=google
STAFF_API_HOST=127.0.0.1
STAFF_API_PORT=3002
STAFF_COOKIE_PREFIX=luma-staff
STAFF_GOOGLE_CLIENT_ID=
STAFF_GOOGLE_CLIENT_SECRET=
STAFF_GOOGLE_HOSTED_DOMAIN=example.com
# Required in production: exact proxy IPs or narrow CIDRs, comma-separated.
# Include only ingress proxies that overwrite X-Forwarded-For with verified client addresses.
STAFF_TRUSTED_PROXY=127.0.0.1
# Set NODE_ENV=production in deployed processes. Local mode is restricted to loopback.
NODE_ENV=production
