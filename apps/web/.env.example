# No environment variables are required for the initial web app.
# VITE_* variables are public and bundled into browser code. Never put secrets here.
# Optional manual development settings. Managed pnpm dev supplies these automatically.
# WEB_PORT=3000
# API_PROXY_TARGET=http://127.0.0.1:3001

# Server-only settings, matching the API cell. Never prefix these with VITE_.
# LUMA_REGION=AU
# LUMA_GLOBAL_ENTRY_URL=https://app.example.com
# LUMA_REGIONAL_ORIGINS={"AU":"https://au.app.example.com"}
# Route authenticated traffic directly to its regional origin. The global entry only redirects.
