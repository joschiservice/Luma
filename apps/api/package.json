{
  "name": "@luma/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --include '../../packages/config/dist/**/*.js' --include '../../packages/api-contract/dist/**/*.js' --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "worker": "node --env-file-if-exists=.env dist/index.js --workflow-worker",
    "dev:worker": "tsx watch --include '../../packages/config/dist/**/*.js' --include 'src/modules/workflows/infrastructure/exception-workflow.ts' --env-file-if-exists=.env src/index.ts --workflow-worker"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@temporalio/testing": "1.24.0",
    "@types/pg": "8.20.0",
    "graphql": "^16.14.2",
    "playwright": "1.63.0",
    "tsx": "^4.20.0"
  },
  "dependencies": {
    "@langfuse/otel": "5.11.1",
    "@luma/api-contract": "workspace:*",
    "@luma/config": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@sentry/node": "10.75.0",
    "@sentry/opentelemetry": "10.75.0",
    "@shopify/admin-api-client": "2.0.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/fastify": "3.52.1",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "pg": "8.20.0",
    "posthog-node": "5.52.4",
    "zod": "3.25.76"
  }
}
