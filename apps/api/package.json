{
  "name": "@luma/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch --conditions=luma-source --include \"../../packages/*/src/**/*.ts\" --env-file-if-exists=.env src/composition/bootstrap.ts",
    "start": "node --env-file-if-exists=.env dist/composition/bootstrap.js",
    "db:migrate": "node --env-file-if-exists=.env ../../packages/application-runtime/scripts/migrate.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@temporalio/testing": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "0.31.11",
    "playwright": "catalog:",
    "tsx": "catalog:",
    "graphql": "catalog:",
    "@luma/simulator-shopify": "workspace:*",
    "@luma/staff": "workspace:*"
  },
  "dependencies": {
    "@luma/application-runtime": "workspace:*",
    "@luma/config": "workspace:*",
    "@luma/platform": "workspace:*",
    "@opentelemetry/instrumentation": "catalog:"
  }
}
