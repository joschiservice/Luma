{
  "name": "@luma/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@types/pg": "8.20.0",
    "tsx": "^4.20.0"
  },
  "dependencies": {
    "@langfuse/otel": "5.11.1",
    "@luma/api-contract": "workspace:*",
    "@luma/config": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@sentry/node": "10.75.0",
    "@sentry/opentelemetry": "10.75.0",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/fastify": "3.52.1",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "pg": "8.20.0",
    "posthog-node": "5.52.4",
    "zod": "3.25.76"
  }
}
