{
  "name": "@luma/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch --conditions=luma-source --include \"../../packages/*/src/**/*.ts\" --env-file-if-exists=.env src/composition/bootstrap.ts",
    "start": "node --env-file-if-exists=.env dist/composition/bootstrap.js",
    "db:migrate": "node --env-file-if-exists=.env ../../packages/application-runtime/scripts/migrate.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "@temporalio/testing": "1.24.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.11",
    "graphql": "^16.14.2",
    "playwright": "1.63.0",
    "tsx": "^4.20.0"
  },
  "dependencies": {
    "@luma/application-runtime": "workspace:*",
    "@luma/config": "workspace:*",
    "@luma/platform": "workspace:*",
    "@opentelemetry/instrumentation": "0.222.0"
  }
}
