# Optional local overrides. Production should inject these through its environment.
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Use a restricted login granted luma_identity. Do not use migration credentials.
IDENTITY_DATABASE_URL=postgresql://luma_api:local_password@127.0.0.1:5432/luma
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Set MIGRATION_DATABASE_URL separately when running db:migrate.

# Telemetry exports are disabled until each provider's credentials are set.
OBSERVABILITY_ENVIRONMENT=development
OBSERVABILITY_RELEASE=local
OBSERVABILITY_SAMPLE_RATE=1
# Required when any telemetry exporter is enabled. Use a random secret of at least 32 characters.
# OBSERVABILITY_TENANT_HASH_KEY=
# EU Sentry project DSN: https://<public-key>@o<org>.ingest.de.sentry.io/<project>
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
