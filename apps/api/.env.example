# Optional local overrides. Production should inject these through its environment.
# One immutable jurisdiction per database and process. Existing EU local databases keep EU.
LUMA_REGION=AU
LUMA_ENABLED_REGIONS=AU
# Exact inspected HTTPS service origins; omitted AU services are disabled.
LUMA_REGIONAL_SERVICE_ENDPOINTS={}
# LUMA_REGIONAL_SERVICE_ENDPOINTS={"AU":{"temporal":["https://temporal.<sydney-host>:7233"],"posthog":["https://posthog.<sydney-host>"]}}
# LUMA_REGIONAL_ORIGINS={"AU":"https://au.app.<domain>"}
# LUMA_GLOBAL_ENTRY_URL=https://app.<domain>
# AUTH_PASSKEY_RP_ID=app.<domain>
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Use a restricted login granted luma_identity. Do not use migration credentials.
IDENTITY_DATABASE_URL=postgresql://luma_api:local_password@127.0.0.1:5432/luma
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
# Optional cookie namespace when multiple apps share a hostname.
# BETTER_AUTH_COOKIE_PREFIX=luma-local
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Set MIGRATION_DATABASE_URL separately when running db:migrate.

# Telemetry exports are disabled until each provider's credentials are set.
OBSERVABILITY_ENVIRONMENT=development
OBSERVABILITY_RELEASE=local
OBSERVABILITY_SAMPLE_RATE=1
# Required when any telemetry exporter is enabled. Use a random secret of at least 32 characters.
# OBSERVABILITY_TENANT_HASH_KEY=
# EU Sentry project DSN: https://<public-key>@o<org>.ingest.de.sentry.io/<project>
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://langfuse.<regional-host>
# Project API key (phc_) for product events and flags. PostHog is used only in staging and
# production; development and test never contact it.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://posthog.<regional-host>
# Project secret key (phs_) for local flag evaluation; keep it server-only.
# POSTHOG_SECRET_KEY=
# Development and test only: comma-separated flag=true|false values that replace evaluation.
# FEATURE_FLAG_OVERRIDES=observability-test=true
# Shipping pilot: starshipit-fulfillment=true,starshipit-actions=true,shopify-shipment-publishing=true

# Model calls are disabled until routes are configured. Public/synthetic data only
# on Vercel; tenant data requires the regional Bedrock route. See docs/model-gateway.md.
MODEL_GATEWAY_ROUTES={}
MODEL_GATEWAY_TIMEOUT_MS=30000
# AI_GATEWAY_API_KEY=
# MODEL_GATEWAY_ROUTES={"reasoning":{"adapter":"vercel","model":"anthropic/claude-sonnet-4.5","providers":["anthropic"],"zeroDataRetention":true}}
# Workflow authoring, supplier message reading, document reading and Ask Luma send tenant data.
# Use Sydney ap-southeast-2 for AU and complete docs/architecture/003-model-processing-path-review.md
# before sending tenant data. The sync process reads the same routes for mailbox documents.
# Restart pnpm dev after changing these values; verify with pnpm evaluate:authoring.
# MODEL_GATEWAY_BEDROCK_REGION=ap-southeast-2
# MODEL_GATEWAY_BEDROCK_ACCESS_KEY_ID=
# MODEL_GATEWAY_BEDROCK_SECRET_ACCESS_KEY=
# Required only for temporary AWS credentials.
# MODEL_GATEWAY_BEDROCK_SESSION_TOKEN=
# MODEL_GATEWAY_ROUTES={"authoring":{"adapter":"bedrock","model":"au.anthropic.claude-sonnet-4-5-20250929-v1:0","providers":["bedrock"],"zeroDataRetention":true},"supplier-extraction":{"adapter":"bedrock","model":"au.anthropic.claude-sonnet-4-5-20250929-v1:0","providers":["bedrock"],"zeroDataRetention":true},"document-extraction":{"adapter":"bedrock","model":"au.anthropic.claude-sonnet-4-5-20250929-v1:0","providers":["bedrock"],"zeroDataRetention":true},"assistant":{"adapter":"bedrock","model":"au.anthropic.claude-sonnet-4-5-20250929-v1:0","providers":["bedrock"],"zeroDataRetention":true}}

# Durable exception worker. Use a cell-local Temporal namespace and restricted database login.
# Grant luma_exceptions, luma_policies, luma_execution and luma_audit to this login.
# WORKFLOW_DATABASE_URL=postgresql://luma_worker:local_password@127.0.0.1:5432/luma
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=luma-exceptions-v1
TEMPORAL_DATA_REGION=AU
TEMPORAL_TLS=false
# Required for Temporal Cloud; TLS must be true. Never put this key in workflow input.
# TEMPORAL_API_KEY=
# Production requires payload encryption with a regional single-region KMS key.
# TEMPORAL_KMS_REGION=ap-southeast-2
# TEMPORAL_KMS_KEY_ARN=arn:aws:kms:ap-southeast-2:<account>:key/<uuid>
# TEMPORAL_KMS_ACCESS_KEY_ID=
# TEMPORAL_KMS_SECRET_ACCESS_KEY=
# TEMPORAL_KMS_SESSION_TOKEN=
# Retain previous key ARNs until all histories encrypted under them have expired.
# TEMPORAL_KMS_DECRYPTION_KEY_ARNS=
# TEMPORAL_KMS_CACHE_TTL_MS=60000
# TEMPORAL_KMS_CACHE_MAX_USES=1000

# Connection credentials use AES-256-GCM. Supply persistent 32-byte base64 keys.
# Grant luma_connectors to the IDENTITY_DATABASE_URL login.
# Managed local development generates these automatically in .luma/.
# CONNECTIONS_ACTIVE_KEY_ID=primary
# CONNECTIONS_KEYS={"primary":"<32-byte-base64-key>"}
# JTL on-premise requires an exact API root and pinned IPs for each Luma organization.
# Keep TLS certificates valid for the hostname. Empty means no on-premise access.
JTL_ALLOWED_ENDPOINTS=[]
# JTL_ALLOWED_ENDPOINTS=[{"tenantId":"<organization-uuid>","baseUrl":"https://erp.example.com/api/company/","addresses":["10.0.0.5"]}]

# Luma-owned Shopify app. Set all five values together; use separate apps per environment.
# Callback routes through the public web origin's /api proxy.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_ENVIRONMENT=
SHOPIFY_CALLBACK_URL=
SHOPIFY_WEB_ORIGIN=
# Set true only after protected customer data approval for this Shopify app.
SHOPIFY_PROTECTED_CUSTOMER_DATA_APPROVED=false
# Enable only after Shopify approves name, email and phone access.
SHOPIFY_CUSTOMER_CONTACT_APPROVED=false
# Enable only after Shopify approves customer address access; imports default and order addresses.
SHOPIFY_CUSTOMER_ADDRESS_APPROVED=false

# Luma-owned Google OAuth app for Gmail. Set all five values together; use separate OAuth
# clients per environment. The callback routes through the public web origin's /api proxy.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_APP_ENVIRONMENT=
GMAIL_CALLBACK_URL=
GMAIL_WEB_ORIGIN=
# Optional Gmail push through Pub/Sub; set all three together. Without them, mailboxes are
# polled. The audience is the push subscription's OIDC audience, the service account the one
# the subscription signs its token as.
# GMAIL_PUBSUB_STORAGE_REGIONS=australia-southeast1
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# GMAIL_PUSH_AUDIENCE=https://app.example.com/api/v1/gmail/push
# GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push@<project>.iam.gserviceaccount.com

# Local Docker telemetry; pnpm dev:observe supplies the mapped ports automatically.
# LUMA_LOCAL_OTLP_ENDPOINT=http://127.0.0.1:4318
# LUMA_LOCAL_PROFILES_ENDPOINT=http://127.0.0.1:4040

# Resend is disabled for AU: mail content is stored in the US.
# Optional workspace invitations and notifications for explicitly admitted regions. Configure all three together.
# MAIL_RESEND_API_KEY=re_...
# MAIL_FROM=Luma <notifications@example.com>
# MAIL_PUBLIC_ORIGIN=https://app.example.com
# Optional: signing secret of a Resend webhook for delivery, bounce and complaint events, sent to
# <public API origin>/api/v1/email/resend/events. Needs the three settings above.
# MAIL_RESEND_WEBHOOK_SECRET=whsec_...

# Enable only after Shopify grants the app access to orders older than 60 days.
SHOPIFY_ALL_ORDERS_APPROVED=false

# Commerce sync: tenants (1-32), pages per workspace (1-8), streams per connection (1-4).
COMMERCE_SYNC_CONCURRENCY=4
COMMERCE_SYNC_WORKSPACE_CONCURRENCY=4
COMMERCE_SYNC_CONNECTION_CONCURRENCY=2
# Operations inbox, read by the sync process: days message text and attachment content are kept
# (30-3650) and seconds between reads of a current mailbox (30-3600).
MESSAGING_RETENTION_DAYS=365
MESSAGING_POLL_SECONDS=120

# Region-local Valkey coordinator; local setup supplies this automatically.
SHOPIFY_ADMISSION_URL=
SHOPIFY_ADMISSION_CLUSTER=false
