{
  "name": "@luma/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache --passWithNoTests",
    "start": "node --env-file-if-exists=.env dist/bootstrap.js",
    "dev:worker": "tsx watch --conditions=luma-source --include \"../../packages/*/src/**/*.ts\" --env-file-if-exists=.env src/bootstrap.ts",
    "start:sync": "node --env-file-if-exists=.env dist/sync-bootstrap.js",
    "dev": "tsx watch --conditions=luma-source --include \"../../packages/*/src/**/*.ts\" --env-file-if-exists=../api/.env --env-file-if-exists=.env src/sync-bootstrap.ts"
  },
  "dependencies": {
    "@luma/application-runtime": "workspace:*",
    "@luma/config": "workspace:*",
    "@luma/platform": "workspace:*",
    "@opentelemetry/instrumentation": "catalog:"
  },
  "devDependencies": {
    "@luma/typescript-config": "workspace:*",
    "tsx": "catalog:"
  }
}
